---
// Built for agents - the value is that the AI people (and you) ask answers from
// your real, verified docs, not a stale crawl. An agent-answer illustration plus
// the three machine-readable artifacts docstube ships.
const cards = [
  {
    title: 'llms.txt + llms-full.txt',
    body: 'Every site ships a compact and a full machine index, so agents read accurate, current context instead of guessing.',
    icon: '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/>'
  },
  {
    title: 'Docs-serving MCP server',
    body: 'Point Claude, Codex, or any MCP client at your docs and let it answer from verified pages - not a stale crawl.',
    icon: '<rect x="5" y="5" width="14" height="14" rx="2"/><rect x="9" y="9" width="6" height="6" rx="1"/><path d="M9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3"/>'
  },
  {
    title: 'Compiler-extracted API refs',
    body: 'References are pulled from real signatures via TypeDoc and griffe, so the types agents read match the types you ship.',
    icon: '<path d="m9 8-4 4 4 4"/><path d="m15 8 4 4-4 4"/>'
  }
];
---

<div class="grid items-center gap-8 lg:grid-cols-[1.05fr_0.95fr]">
  <!-- an agent answering from your verified docs -->
  <div class="surface overflow-hidden">
    <div class="flex items-center gap-2.5 border-b border-line bg-canvas px-4 py-3">
      <span class="flex h-7 w-7 items-center justify-center rounded-lg text-[#6d4ee6]" style="background:#ece6fd"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.5l1.7 5.8L19.5 10l-5.8 1.7L12 17.5l-1.7-5.8L4.5 10l5.8-1.7z" /></svg></span>
      <span class="font-mono text-[12px] text-ink-soft">coding agent</span>
      <span class="ml-auto inline-flex items-center gap-1.5 rounded-full bg-pass/12 px-2.5 py-1 font-mono text-[10px] font-semibold text-pass"><span class="h-1.5 w-1.5 rounded-full bg-pass"></span> reading your docs</span>
    </div>
    <div class="space-y-3 p-5 sm:p-6">
      <div class="ml-auto w-fit max-w-[80%] rounded-2xl rounded-br-sm bg-brand-500 px-3.5 py-2 text-[13px] leading-snug text-paper shadow-soft">How do I authenticate with Acme?</div>
      <div class="w-fit max-w-[92%] rounded-2xl rounded-bl-sm border border-line bg-paper px-3.5 py-3 shadow-soft">
        <p class="text-[13px] leading-relaxed text-ink-soft">Call <code class="rounded bg-brand-50 px-1 font-mono text-[12px] text-brand-700">acme.connect(token)</code> to get a <code class="rounded bg-brand-50 px-1 font-mono text-[12px] text-brand-700">Session</code>, then attach it to every request. Sessions expire after 60 minutes — refresh before they do.</p>
        <div class="mt-3 flex flex-wrap items-center gap-2 border-t border-line pt-2.5">
          <span class="inline-flex items-center gap-1.5 rounded-md border border-pass/30 bg-pass/8 px-2 py-1 font-mono text-[10px] font-semibold text-pass"><svg width="9" height="9" viewBox="0 0 12 12" fill="none"><path d="M2.5 6.2 5 8.7 9.5 3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg> verified</span>
          <span class="font-mono text-[10px] text-muted">source: yourproject.dev/auth · via MCP</span>
        </div>
      </div>
      <p class="flex items-center gap-2 pl-1 font-mono text-[10.5px] text-muted"><svg width="11" height="11" viewBox="0 0 14 14" class="shrink-0 text-danger"><path d="M4 4l6 6M10 4l-6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg> without your docs: it guesses from a two-year-old blog post</p>
    </div>
  </div>

  <!-- the machine-readable artifacts -->
  <div class="flex flex-col gap-3.5">
    {
      cards.map((c) => (
        <div class="surface hover-lift flex items-start gap-3.5 p-5">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={c.icon} />
          </span>
          <div>
            <h3 class="font-display text-[16px] font-semibold text-ink">{c.title}</h3>
            <p class="mt-1 text-[13.5px] leading-relaxed text-muted">{c.body}</p>
          </div>
        </div>
      ))
    }
  </div>
</div>
