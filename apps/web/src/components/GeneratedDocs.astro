    --dp-border: #2f3434;
    --dp-accent: #36bebe;
    --dp-active: #2b3231;
    --dp-inline: rgba(54, 190, 190, 0.14);
    --dp-codebg: #1b2221;
    --dp-codetext: #cfeae6;
    --dp-kw: #569cd6;
    --dp-str: #ce9178;
    --dp-fn: #dcdcaa;
    --dp-var: #9cdcfe;
  }
  .dp-code {
    background: var(--dp-codebg);
    color: var(--dp-codetext);
  }
  .dp-code .k {
    color: var(--dp-kw);
  }
  .dp-code .s {
    color: var(--dp-str);
  }
  .dp-code .f {
    color: var(--dp-fn);
  }
  .dp-code .v {
    color: var(--dp-var);
  }
  [data-rail-pill] {
    position: absolute;
    left: 0;
    top: 0;
    transition:
      left 0.28s var(--ease-spring),
      width 0.28s var(--ease-spring),
      top 0.25s ease,
      height 0.25s ease;
  }
  .dp-themebtn,
  .dp-cbtab {
    color: var(--dp-muted);
    cursor: pointer;
  }
  .dp-themebtn.dp-on,
