<script>
  // doc preview: Tabs-style theme switch + animated code tabs + collapsible nav.
  const movePill = (rail: HTMLElement) => {
    const pill = rail.querySelector<HTMLElement>('[data-rail-pill]');
    const on = rail.querySelector<HTMLElement>('.dp-on') || rail.querySelector<HTMLButtonElement>('button');
    if (!pill || !on) return;
    pill.style.left = `${on.offsetLeft}px`;
    pill.style.top = `${on.offsetTop}px`;
    pill.style.width = `${on.offsetWidth}px`;
    pill.style.height = `${on.offsetHeight}px`;
  };

  const setupDocPreview = () => {
    const rails: HTMLElement[] = [];
    document.querySelectorAll<HTMLElement>('[data-doc-preview]').forEach((root) => {
      const themeRail = root.querySelector<HTMLElement>('[data-theme-rail]');
      if (themeRail) {
        rails.push(themeRail);
        const btns = Array.from(themeRail.querySelectorAll<HTMLButtonElement>('[data-theme-mode]'));
        btns.forEach((b) =>
          b.addEventListener('click', () => {
            root.classList.toggle('is-dark', b.dataset.themeMode === 'dark');
            btns.forEach((x) => x.classList.toggle('dp-on', x === b));
            movePill(themeRail);
          })
        );
      }
      const cbRail = root.querySelector<HTMLElement>('[data-cb-rail]');
      if (cbRail) {
        rails.push(cbRail);
        const btns = Array.from(cbRail.querySelectorAll<HTMLButtonElement>('[data-cb-tab]'));
        const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-cb-panel]'));
        btns.forEach((b, i) =>
          b.addEventListener('click', () => {
            btns.forEach((x, idx) => x.classList.toggle('dp-on', idx === i));
            panels.forEach((p, idx) => (p.hidden = idx !== i));
            movePill(cbRail);
          })
        );
      }
      root.querySelectorAll<HTMLButtonElement>('[data-doc-acc-btn]').forEach((btn) =>
        btn.addEventListener('click', () => btn.closest<HTMLElement>('[data-doc-acc]')?.classList.toggle('open'))
      );
    });
    const place = () => rails.forEach(movePill);
    requestAnimationFrame(place);
    window.addEventListener('load', place);
    window.addEventListener('resize', place);
  };

  if (document.readyState !== 'loading') setupDocPreview();
  else document.addEventListener('DOMContentLoaded', setupDocPreview);
</script>
