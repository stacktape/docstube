---
// TEMPORARY preview page for three reworked homepage sections (after the hero):
//   Section 2 - Use cases (public docs + internal wikis), benefit-led, meaningful illustrations.
//   Section 3 - Generated docs vs world-class platforms: an interactive, light-default sample site
//               (fuller nested nav w/ icons + gutter, clean in-page TOC, Tabs-style theme switch,
//               theme-aware tabbed code block, a clean D2 diagram) + a feature gallery.
//   Section 4 - Easy human review: leave a comment on the rendered page; docstube fixes it and remembers.
// On-brand (teal/light/editorial). The doc-preview is one consistent "Acme" auth doc.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const useCases = [
  {
    title: 'Public docs',
    audience: 'OSS maintainers · API companies',
    lead: 'A site that markets your project while it teaches it — and that every channel can find.',
    points: [
      { h: 'Adoption follows good docs', b: 'Developers commit to the tool they can learn fastest. A clear, searchable site is how you become that tool.' },
      { h: 'Found by people and their AI', b: 'SEO, AEO, and an llms.txt out of the box — so search engines, answer engines, and coding agents all cite your real API.' },
      { h: 'Correct, not just fluent', b: 'Every sample is type-checked and every reference matches your compiler, so the code a reader copies actually runs.' }
    ]
  },
  {
    title: 'Internal wiki',
    audience: 'engineering teams',
    lead: 'The private reference for a codebase that changes faster than anyone can document by hand.',
    points: [
      { h: 'Onboarding that keeps up', b: 'New hires ramp on docs that match main — not a wiki that went stale three sprints ago.' },
      { h: 'Answers without the interruption', b: 'Instant search over always-current pages, so nobody pings the one engineer who still remembers how it works.' },
      { h: 'Context your agents can trust', b: 'Ships an llms.txt and an MCP server, so the coding agents on your team read accurate internals instead of guessing.' }
    ]
  }
];
---

<Base title="docstube - reworked sections (preview)" description="Internal preview of reworked homepage sections.">
  <Header />

  <main>
    <section class="grid-bg relative overflow-hidden border-b border-line">
      <div class="glow relative mx-auto max-w-3xl px-5 py-14 text-center sm:px-8">
        <span class="chip"><span class="h-1.5 w-1.5 rounded-full bg-brand-400"></span> internal preview, not linked</span>
        <h1 class="mt-5 text-balance text-3xl font-extrabold sm:text-4xl">Reworked sections.</h1>
        <p class="mt-4 text-[16px] leading-relaxed text-muted">
          Section&nbsp;3 sample site: switch the theme (code block follows it), flip the animated code tabs, collapse
          the nested nav. Section&nbsp;4 is reworked into a doc-comment thread. View at desktop width to see both side
          panels.
        </p>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- SECTION 2 - Use cases, by their benefits                     -->
    <!-- ============================================================ -->
    <div class="bg-ink">
      <div class="mx-auto flex max-w-6xl items-center gap-3 px-5 py-3 sm:px-8">
        <span class="font-display text-[15px] font-bold text-paper">Section 2</span>
        <span class="font-mono text-[12px] text-paper/60">Use cases — each illustration shows what the use case actually does for you</span>
      </div>
    </div>

    <section class="border-b border-line bg-paper">
      <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-24">
        <div class="mx-auto flex max-w-2xl flex-col items-center gap-4 text-center">
          <span class="eyebrow">Use cases</span>
          <h2 class="text-balance text-3xl font-bold sm:text-[40px] sm:leading-[1.08]">Win adoption. Unblock your team.</h2>
        </div>
        <div class="mt-14 grid gap-6 lg:grid-cols-2">
          <!-- PUBLIC -->
          <div class="surface hover-lift flex flex-col overflow-hidden">
            <div class="relative h-[252px] overflow-hidden border-b border-line bg-gradient-to-b from-canvas to-paper">
              <div class="pointer-events-none absolute inset-0 grid place-items-center" aria-hidden="true"><span class="h-[340px] w-[340px] rounded-full border border-dashed border-line-strong/55"></span></div>
              <div class="absolute left-6 top-7 w-[260px] -rotate-2 rounded-xl border border-line bg-paper p-3.5 shadow-soft">
                <div class="flex items-center gap-2 rounded-full border border-line bg-canvas px-2.5 py-1"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="text-muted"><circle cx="11" cy="11" r="7" /><path d="m21 21-4-4" /></svg><span class="font-mono text-[10px] text-muted">acme authentication</span></div>
                <div class="mt-2.5">
                  <p class="font-mono text-[9px] text-pass">yourproject.dev › docs › auth</p>
                  <p class="text-[12.5px] font-medium text-brand-700">Authentication — Acme docs</p>
                  <p class="text-[10px] leading-snug text-muted">Create a session and attach it to every request. Sessions expire after 60 minutes…</p>
                </div>
              </div>
              <div class="absolute bottom-6 right-5 w-[244px] rotate-2 rounded-xl border border-line bg-paper p-3.5 shadow-lift">
                <div class="flex items-center gap-1.5"><span class="flex h-5 w-5 items-center justify-center rounded-full text-[#6d4ee6]" style="background:#ece6fd"><svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3l1.6 5.4L19 10l-5.4 1.6L12 17l-1.6-5.4L5 10l5.4-1.6z" /></svg></span><span class="font-mono text-[9.5px] font-semibold text-ink-soft">AI answer</span></div>
                <p class="mt-2 text-[11px] leading-relaxed text-ink-soft">Call <span class="font-mono text-ink">acme.connect()</span> to authenticate, then reuse the session.</p>
                <div class="mt-2.5 inline-flex items-center gap-1 rounded-md border border-line bg-canvas px-2 py-0.5"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="text-brand-500"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1" /><path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1" /></svg><span class="font-mono text-[9px] text-muted">yourproject.dev/auth</span></div>
              </div>
            </div>
            <div class="flex flex-1 flex-col gap-5 p-7 sm:p-8">
              <div><h3 class="font-display text-[22px] font-semibold text-ink">{useCases[0].title}</h3><p class="mt-1 font-mono text-[12px] text-muted">{useCases[0].audience}</p><p class="mt-3 text-[14.5px] leading-relaxed text-ink-soft">{useCases[0].lead}</p></div>
              <ul class="flex flex-col gap-3 border-t border-line pt-5">
                {useCases[0].points.map((p) => (
                  <li class="flex gap-3"><span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand-600"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2.5 6.2 5 8.7 9.5 3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></span><p class="text-[13.5px] leading-relaxed text-muted"><span class="font-semibold text-ink">{p.h}.</span> {p.b}</p></li>
                ))}
              </ul>
            </div>
          </div>
          <!-- INTERNAL -->
          <div class="surface hover-lift flex flex-col overflow-hidden">
            <div class="relative h-[252px] overflow-hidden border-b border-line bg-gradient-to-b from-canvas to-paper">
              <div class="pointer-events-none absolute inset-0 grid place-items-center" aria-hidden="true"><span class="h-[340px] w-[340px] rounded-full border border-dashed border-line-strong/55"></span></div>
              <div class="absolute left-6 top-8 flex w-[250px] items-center gap-2 rounded-full border border-line bg-paper px-3.5 py-2 shadow-soft">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="text-brand-500"><circle cx="11" cy="11" r="7" /><path d="m21 21-4-4" /></svg>
                <span class="text-[12px] text-ink-soft">How does auth work?</span>
              </div>
              <div class="absolute bottom-7 right-5 w-[262px] rounded-xl border border-line bg-paper p-3.5 shadow-lift">
                <div class="flex items-center justify-between"><p class="font-display text-[13px] font-semibold text-ink">Auth service</p><span class="inline-flex items-center gap-1 rounded-full bg-pass/12 px-1.5 py-0.5 font-mono text-[8.5px] font-semibold text-pass"><svg width="8" height="8" viewBox="0 0 12 12" fill="none"><path d="M2.5 6.2 5 8.7 9.5 3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg> matches main</span></div>
                <p class="mt-2 text-[11px] leading-relaxed text-ink-soft">Sessions are minted in <span class="font-mono text-ink">auth.ts</span> and refreshed by the gateway.</p>
                <div class="mt-2.5 flex items-center gap-2 border-t border-line pt-2">
                  <div class="flex -space-x-1.5"><span class="flex h-5 w-5 items-center justify-center rounded-full border-2 border-paper bg-brand-100 text-[8px] font-bold text-brand-700">M</span><span class="flex h-5 w-5 items-center justify-center rounded-full border-2 border-paper bg-brand-100 text-[8px] font-bold text-brand-700">J</span><span class="flex h-5 w-5 items-center justify-center rounded-full border-2 border-paper text-[#6d4ee6]" style="background:#ece6fd"><svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3l1.6 5.4L19 10l-5.4 1.6L12 17l-1.6-5.4L5 10l5.4-1.6z" /></svg></span></div>
                  <span class="font-mono text-[8.5px] text-muted">synced from main · 2m ago</span>
                </div>
              </div>
            </div>
            <div class="flex flex-1 flex-col gap-5 p-7 sm:p-8">
              <div><h3 class="font-display text-[22px] font-semibold text-ink">{useCases[1].title}</h3><p class="mt-1 font-mono text-[12px] text-muted">{useCases[1].audience}</p><p class="mt-3 text-[14.5px] leading-relaxed text-ink-soft">{useCases[1].lead}</p></div>
              <ul class="flex flex-col gap-3 border-t border-line pt-5">
                {useCases[1].points.map((p) => (
                  <li class="flex gap-3"><span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand-600"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2.5 6.2 5 8.7 9.5 3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></span><p class="text-[13.5px] leading-relaxed text-muted"><span class="font-semibold text-ink">{p.h}.</span> {p.b}</p></li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- SECTION 3 - World-class generated docs (interactive preview) -->
    <!-- ============================================================ -->
    <div class="bg-ink">
      <div class="mx-auto flex max-w-6xl items-center gap-3 px-5 py-3 sm:px-8">
        <span class="font-display text-[15px] font-bold text-paper">Section 3</span>
        <span class="font-mono text-[12px] text-paper/60">On par with world-class platforms — a live sample site (theme-aware, animated) + feature gallery</span>
      </div>
    </div>

    <section class="dot-bg border-b border-line">
      <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-24">
        <div class="mx-auto flex max-w-2xl flex-col items-center gap-4 text-center">
          <span class="eyebrow">Beautiful &amp; feature-rich</span>
          <h2 class="text-balance text-3xl font-bold sm:text-[42px] sm:leading-[1.06]">As polished as the best docs platforms</h2>
          <p class="text-[16px] leading-relaxed text-muted">Instant search, rendered diagrams, type-checked samples, API references, light and dark — every component a great docs site needs, and you wrote none of it.</p>
        </div>

        <!-- the live sample site (one consistent "Acme" auth doc) -->
        <div class="relative mx-auto mt-14 max-w-5xl">
          <div class="pointer-events-none absolute inset-x-0 -top-10 h-48" aria-hidden="true" style="background:radial-gradient(55% 100% at 50% 0%, rgba(54,177,176,0.18), transparent 70%)"></div>
          <div data-doc-preview class="relative overflow-hidden rounded-2xl border shadow-lift" style="background:var(--dp-bg); border-color:var(--dp-border)">
            <!-- chrome: centered search + Ask AI, theme switch on the right -->
            <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-2 px-4 py-2.5" style="border-bottom:1px solid var(--dp-border)">
              <div class="flex items-center gap-2">
                <span class="h-2.5 w-2.5 rounded-full" style="background:var(--dp-border)"></span><span class="h-2.5 w-2.5 rounded-full" style="background:var(--dp-border)"></span><span class="h-2.5 w-2.5 rounded-full" style="background:var(--dp-border)"></span>
              </div>
              <div class="hidden items-center gap-2 sm:flex">
                <div class="flex w-[210px] items-center gap-2 rounded-lg px-2.5 py-[7px]" style="background:var(--dp-card); border:1px solid var(--dp-border); cursor:text">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="color:var(--dp-muted)"><circle cx="11" cy="11" r="7" /><path d="m21 21-4-4" /></svg>
                  <span class="text-[11px]" style="color:var(--dp-muted)">Search documentation…</span>
                  <span class="ml-auto rounded px-1.5 py-0.5 font-mono text-[8.5px]" style="background:color-mix(in srgb, var(--dp-text) 9%, transparent); color:var(--dp-muted)">⌘K</span>
                </div>
                <button type="button" class="flex items-center gap-1.5 rounded-lg px-2.5 py-[7px] text-[11px] font-semibold" style="background:color-mix(in srgb, var(--dp-accent) 13%, transparent); color:var(--dp-accent); cursor:pointer">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3l1.5 5L19 9.5 13.5 11 12 16l-1.5-5L5 9.5 10.5 8z" /></svg>
                  Ask AI
                </button>
              </div>
              <div class="flex justify-end">
                <div data-theme-rail class="relative inline-flex items-center gap-0.5 rounded-[9px] p-[3px]" style="background:color-mix(in srgb, var(--dp-text) 8%, transparent)">
                  <span data-rail-pill style="background:var(--dp-bg); box-shadow:var(--shadow-soft); border-radius:7px"></span>
                  <button type="button" data-theme-mode="light" class="dp-themebtn dp-on relative z-10 flex items-center gap-1 rounded-[7px] px-2 py-1 font-mono text-[10px] font-semibold"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4" /><path d="M12 3v1M12 20v1M3 12h1M20 12h1M5.6 5.6l.7.7M17.7 17.7l.7.7M18.4 5.6l-.7.7M6.3 17.7l-.7.7" stroke-linecap="round" /></svg>Light</button>
                  <button type="button" data-theme-mode="dark" class="dp-themebtn relative z-10 flex items-center gap-1 rounded-[7px] px-2 py-1 font-mono text-[10px] font-semibold"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z" stroke-linecap="round" stroke-linejoin="round" /></svg>Dark</button>
                </div>
              </div>
            </div>
            <!-- 3-pane body -->
            <div class="grid lg:grid-cols-[222px_1fr_188px]">
              <!-- LEFT NAV (fuller, icons on sections, nested gutter, pretty active) -->
              <nav class="hidden p-3 text-[12.5px] lg:block" style="border-right:1px solid var(--dp-border)">
                <p class="flex items-center gap-1.5 px-2.5 pb-1.5 font-mono text-[10px] font-semibold uppercase tracking-[0.06em]" style="color:var(--dp-muted)"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V4s-1 1-4 1-5-2-8-2-4 1-4 1z" /><path d="M4 22v-7" /></svg>Getting started</p>
                <div class="space-y-0.5">
                  <a class="dp-navitem block rounded-[7px] px-2.5 py-1.5" style="color:var(--dp-muted)">Installation</a>
                  <a class="dp-navitem block rounded-[7px] px-2.5 py-1.5" style="color:var(--dp-muted)">Quickstart</a>
                  <a class="dp-navitem block rounded-[7px] px-2.5 py-1.5" style="color:var(--dp-muted)">Project setup</a>
                </div>
                <p class="mt-3 flex items-center gap-1.5 px-2.5 pb-1.5 font-mono text-[10px] font-semibold uppercase tracking-[0.06em]" style="color:var(--dp-muted)"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" /></svg>Guides</p>
                <div class="space-y-0.5">
                  <div data-doc-acc class="open">
                    <button type="button" data-doc-acc-btn class="dp-navitem relative flex w-full items-center gap-1.5 rounded-[7px] py-1.5 pl-3.5 pr-2.5 font-medium" style="background:var(--dp-active); color:var(--dp-text)">
                      <span class="absolute left-1 top-1/2 h-3.5 w-[3px] -translate-y-1/2 rounded-full" style="background:var(--dp-accent)"></span>
                      <svg data-doc-acc-chevron width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m9 6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                      Authentication
                    </button>
                    <div data-doc-acc-panel><div class="overflow-hidden">
                      <div class="ml-[15px] mt-0.5 space-y-0.5 pl-2.5" style="border-left:1px solid var(--dp-border)">
                        <a class="dp-navitem block rounded-[7px] px-2.5 py-1.5" style="color:var(--dp-muted)">Sessions</a>
                        <a class="dp-navitem block rounded-[7px] px-2.5 py-1.5" style="color:var(--dp-muted)">API keys</a>
                        <a class="dp-navitem block rounded-[7px] px-2.5 py-1.5" style="color:var(--dp-muted)">OAuth</a>
                      </div>
                    </div></div>
                  </div>
                  <a class="dp-navitem block rounded-[7px] px-2.5 py-1.5" style="color:var(--dp-muted)">Webhooks</a>
                  <a class="dp-navitem block rounded-[7px] px-2.5 py-1.5" style="color:var(--dp-muted)">Rate limits</a>
                  <a class="dp-navitem block rounded-[7px] px-2.5 py-1.5" style="color:var(--dp-muted)">Pagination</a>
                  <a class="dp-navitem block rounded-[7px] px-2.5 py-1.5" style="color:var(--dp-muted)">Errors</a>
                </div>
                <p class="mt-3 flex items-center gap-1.5 px-2.5 pb-1.5 font-mono text-[10px] font-semibold uppercase tracking-[0.06em]" style="color:var(--dp-muted)"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m8 6-6 6 6 6" /><path d="m16 6 6 6-6 6" /></svg>API reference</p>
                <div class="space-y-0.5">
                  <a class="dp-navitem block rounded-[7px] px-2.5 py-1.5" style="color:var(--dp-muted)">Client</a>
                  <a class="dp-navitem block rounded-[7px] px-2.5 py-1.5" style="color:var(--dp-muted)">Session</a>
                  <a class="dp-navitem block rounded-[7px] px-2.5 py-1.5" style="color:var(--dp-muted)">Webhook</a>
                </div>
              </nav>

              <!-- CONTENT -->
              <article class="space-y-5 p-6 sm:p-7" style="color:var(--dp-text)">
                <div>
                  <p class="font-mono text-[11px]" style="color:var(--dp-muted)">Guides › Authentication</p>
                  <h3 class="mt-1.5 font-display text-[26px] font-semibold" style="color:var(--dp-text)">Authentication</h3>
                  <p class="mt-2.5 text-[13.5px] leading-relaxed" style="color:var(--dp-muted)">Acme uses short-lived <span class="rounded px-1 font-mono text-[11.5px]" style="background:var(--dp-inline); color:var(--dp-accent)">sessions</span>. Create one with <span class="rounded px-1 font-mono text-[11.5px]" style="background:var(--dp-inline); color:var(--dp-accent)">connect()</span>, then attach the returned <span class="rounded px-1 font-mono text-[11.5px]" style="background:var(--dp-inline); color:var(--dp-accent)">Session</span> to every request.</p>
                </div>
                <!-- theme-aware tabbed code block -->
                <div class="dp-code overflow-hidden rounded-xl" style="box-shadow:0 1px 3px rgba(13,50,48,.08), 0 0 0 1px color-mix(in srgb, var(--dp-text) 7%, transparent)">
                  <div class="flex items-center gap-2 px-3 pt-3">
                    <div data-cb-rail class="relative inline-flex items-center gap-0.5 rounded-lg p-[3px]" style="background:color-mix(in srgb, var(--dp-text) 7%, transparent)">
                      <span data-rail-pill style="background:var(--dp-bg); box-shadow:var(--shadow-soft); border-radius:6px"></span>
                      <button type="button" data-cb-tab class="dp-cbtab dp-on relative z-10 rounded-md px-2.5 py-1 font-mono text-[11.5px] font-semibold">client.ts</button>
                      <button type="button" data-cb-tab class="dp-cbtab relative z-10 rounded-md px-2.5 py-1 font-mono text-[11.5px] font-semibold">client.py</button>
                    </div>
                    <svg class="ml-auto" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--dp-muted)"><rect x="9" y="9" width="11" height="11" rx="2" /><path d="M5 15V5a2 2 0 0 1 2-2h10" /></svg>
                  </div>
                  <div data-cb-panel class="px-4 pb-4 pt-3 font-mono text-[12px] leading-[1.85]">
                    <div><span class="k">import</span> <span class="v">Acme</span> <span class="k">from</span> <span class="s">'acme'</span></div>
                    <div><span class="k">const</span> <span class="v">acme</span> = <span class="k">new</span> <span class="f">Acme</span>(apiKey)</div>
                    <div><span class="k">const</span> <span class="v">session</span> = <span class="k">await</span> <span class="f">acme.connect</span>()</div>
                  </div>
                  <div data-cb-panel hidden class="px-4 pb-4 pt-3 font-mono text-[12px] leading-[1.85]">
                    <div><span class="k">from</span> <span class="v">acme</span> <span class="k">import</span> <span class="v">Acme</span></div>
                    <div><span class="v">acme</span> = <span class="f">Acme</span>(api_key)</div>
                    <div><span class="v">session</span> = <span class="f">acme.connect</span>()</div>
                  </div>
                </div>
                <!-- clean D2 diagram -->
