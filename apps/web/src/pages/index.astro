---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import RunsOn from '../components/RunsOn.astro';
import AutonomyLadder from '../components/AutonomyLadder.astro';
import BuiltForAgents from '../components/BuiltForAgents.astro';
import Pricing from '../components/Pricing.astro';
import FinalCta from '../components/FinalCta.astro';
import HeroDemo from '../components/HeroDemo.astro';
import DocsProblem from '../components/DocsProblem.astro';
import HowItWorks from '../components/HowItWorks.astro';
import UseCases from '../components/UseCases.astro';
import GeneratedDocs from '../components/GeneratedDocs.astro';
import HumanReview from '../components/HumanReview.astro';
import { site } from '../data/site.ts';
---

<Base
  title="docstube — verified docs, generated from your code"
  description="docstube is the first L4 documentation system: it generates docs from your codebase, proves every claim against the source, and maintains them autonomously — flagged when unprovable, never silently wrong. Open-source, MIT, runs on your own AI."
>
  <Header />

  <main>
    <!-- Hero - copy left, a live generation run on the right -->
    <section class="grid-bg relative overflow-hidden border-b border-line">
      <div class="glow relative mx-auto grid max-w-6xl items-center gap-10 px-5 py-16 sm:px-8 lg:grid-cols-[1fr_1.05fr] lg:gap-14 lg:py-24">
        <!-- Left: copy -->
        <div class="relative z-10 flex flex-col items-start gap-6">
          <a
            href="#ladder"
            class="group inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50/80 py-1.5 pl-1.5 pr-3.5 text-[13px] font-medium text-brand-800 shadow-soft transition hover:border-brand-300 hover:shadow-lift"
          >
            <span class="rounded-full bg-brand-500 px-2 py-0.5 font-mono text-[10.5px] font-bold text-white">L4</span>
            The first fully-autonomous docs system
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-600 transition-transform group-hover:translate-y-0.5" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" /></svg>
          </a>
          <h1 class="text-[40px] font-extrabold leading-[1.05] sm:text-[52px] sm:leading-[1.03]">
            Most technical documentation is trash. <span class="gradient-text">Yours won't be.</span>
          </h1>

          <p class="max-w-xl text-[18px] leading-relaxed text-muted">
            docstube generates it from your codebase, fact-checks every claim against the source, writes it for the
            people actually reading it, and keeps it in sync as your code changes.
            <span class="font-medium text-ink-soft">Nothing to write. Nothing to maintain.</span>
          </p>

          <!-- Trust row (understated) -->
          <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-[13px] text-muted">
            <span class="inline-flex items-center gap-1.5">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-500"><circle cx="12" cy="12" r="9" /><path d="M8.5 12.5l2.5 2.5 5-5" /></svg>
              MIT licensed
            </span>
            <span class="inline-flex items-center gap-1.5">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-500"><circle cx="8" cy="8" r="3.2" /><path d="M10.3 10.3 20 20M16.5 16.5l2-2M14.5 18.5l2-2" /></svg>
              bring your own AI
            </span>
            <span class="inline-flex items-center gap-1.5">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-500"><rect x="5" y="11" width="14" height="9" rx="2" /><path d="M8 11V8a4 4 0 018 0v3" /></svg>
              source stays local
            </span>
          </div>

          <div class="flex flex-col gap-3 sm:flex-row">
            <a href={site.waitlist} class="btn btn-primary">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5" /><path d="m4 7 8 5.5L20 7" /></svg>
              Join the waitlist
            </a>
            <a href="#how" class="btn btn-secondary">
              See how it works
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" /></svg>
            </a>
          </div>
        </div>

        <!-- Right: animated walkthrough of a generation run -->
        <HeroDemo />
      </div>
    </section>

    <!-- Runs on the AI you already use -->
    <div class="border-b border-line bg-paper py-12">
      <RunsOn />
    </div>

    <!-- Why this matters - the problem -->
    <DocsProblem />

    <!-- The autonomy ladder - the category claim and where everyone sits -->
    <AutonomyLadder />

    <!-- How it works - five-step walkthrough -->
    <HowItWorks />

    <!-- Use cases - public docs / internal wiki -->
    <UseCases />

    <!-- Generated docs - world-class + feature-rich -->
    <GeneratedDocs />

    <!-- Easy human review -->
    <HumanReview />

    <!-- Built for agents -->
    <Section eyebrow="Built for agents" title="Your agents read it too — and get it right.">
      <BuiltForAgents />
    </Section>

    <!-- Pricing -->
    <Section
      id="pricing"
      eyebrow="Pricing"
      title="The whole product is free."
      intro="Every feature, MIT-licensed, forever. You pay only your own AI provider, at their prices, with spend caps you set. Paid tiers come later — and they'll sell what a single repo can't have, never the product itself."
      tone="paper"
    >
      <Pricing />
    </Section>

    <FinalCta />
  </main>

  <Footer showVariants={false} />
</Base>
