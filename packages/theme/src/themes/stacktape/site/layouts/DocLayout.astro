---
// Stacktape theme layout — port of the source DocsLayout.astro (theme-spec-stacktape.md §2):
// fixed 54px header, centered 1580px wrapper with 295px sidebar / flexible main / 305px TOC,
// view transitions on the main column. Kernel proof primitives (src/docstube/**) are mandatory
// mounts: the guarantee badge, section chips, sources footer, entity wrapper, and search are a
// conformance contract, not a theme choice — this layout styles them, it does not decide whether
// they exist.
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import DocstubeEntity from '../docstube/DocstubeEntity.astro';
import DocstubeGuarantee from '../docstube/DocstubeGuarantee.astro';
import DocstubeSearch from '../docstube/DocstubeSearch.astro';
import DocstubeSectionChips from '../docstube/DocstubeSectionChips.astro';
import DocstubeSources from '../docstube/DocstubeSources.astro';
import { Sidebar } from '../components/Sidebar.tsx';
import { TableOfContents } from '../components/TableOfContents.tsx';
import {
  footerCredit,
  navByLocale,
  repoUrl,
  siteDescription,
  siteTitle,
  siteUrl,
  sourceLocale,
  versions
} from '../site-data.mjs';

const { frontmatter } = Astro.props;
const headings = Astro.props.headings ?? [];
const title = frontmatter.title ? `${frontmatter.title} | ${siteTitle}` : siteTitle;
const description = frontmatter.description || siteDescription;
const canonicalUrl = siteUrl ? new URL(Astro.url.pathname, siteUrl).href : undefined;
const guarantee = frontmatter.docstubeGuarantee;
const guaranteeTitle = `${frontmatter.docstubeClaimsChecked ?? 0} of ${frontmatter.docstubeClaimsTotal ?? 0} claims checked`;
const locale = frontmatter.docstubeLocale ?? sourceLocale;
const alternates = frontmatter.docstubeAlternates ?? [];
const sourceAlternate = alternates.find((alternate) => alternate.locale === sourceLocale);
const sources = frontmatter.docstubeSources ?? [];
const sections = frontmatter.docstubeSections ?? [];
const nav = navByLocale[locale] ?? navByLocale[sourceLocale] ?? [];
const navGroups = nav.map((group) => ({ label: group.label, entries: group.entries }));
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description ? <meta name="description" content={description} /> : null}
    {canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}
    {
      siteUrl && alternates.length > 1
        ? alternates.map((alternate) => (
            <link rel="alternate" hreflang={alternate.locale} href={new URL(alternate.href, siteUrl).href} />
          ))
        : null
    }
    {
      siteUrl && alternates.length > 1 && sourceAlternate ? (
        <link rel="alternate" hreflang="x-default" href={new URL(sourceAlternate.href, siteUrl).href} />
      ) : null
    }
    <meta property="og:title" content={title} />
    {description ? <meta property="og:description" content={description} /> : null}
    {canonicalUrl ? <meta property="og:url" content={canonicalUrl} /> : null}
    <meta property="og:type" content="article" />
    <ClientRouter />
  </head>
  <body>
    <a class="stp-skip-link" href="#main-content">Skip to content</a>
    <header class="stp-header" transition:persist="docs-header">
      <div class="stp-header-inner">
        <a class="stp-header-title" href="/">
          <span class="stp-header-mark" aria-hidden="true"></span>
          <span class="stp-gradient-text">{siteTitle}</span>
        </a>
        <div class="stp-header-actions">
          <DocstubeSearch />
          <button
            class="stp-icon-button stp-hamburger"
            type="button"
            data-stp-hamburger
            aria-label="Toggle navigation"
          >
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>
        </div>
      </div>
    </header>
    <div class="stp-page-wrapper">
      <div class="stp-mobile-nav" transition:persist="docs-mobile-nav">
        <hr class="stp-mobile-divider" />
        <Sidebar client:load groups={navGroups} pathname={Astro.url.pathname} navId="mobile" />
      </div>
      <aside class="stp-sidebar" aria-label="Documentation" transition:persist="docs-sidebar">
        <Sidebar client:load groups={navGroups} pathname={Astro.url.pathname} navId="desktop" />
      </aside>
      <main id="main-content">
        <div class="stp-toolbar">
          {
            versions.frozen.length > 0 ? (
              <details class="dt-version-switcher">
                <summary>{versions.current}</summary>
                <nav aria-label="Versions">
                  <a href="/">{versions.current}</a>
                  {versions.frozen.map((label) => (
                    <a href={`/versions/${label}/`}>{label}</a>
                  ))}
                </nav>
              </details>
            ) : null
          }
          {
            alternates.length > 1 ? (
              <nav class="dt-locale-switcher" aria-label="Language">
                {alternates.map((alternate) => (
                  <a href={alternate.href} aria-current={alternate.locale === locale ? 'true' : undefined}>
                    {alternate.locale}
                  </a>
                ))}
              </nav>
            ) : null
          }
          {guarantee ? <DocstubeGuarantee guarantee={guarantee} title={guaranteeTitle} /> : null}
        </div>
        <DocstubeEntity entityId={frontmatter.docstubePageId} guarantee={guarantee}>
          <article class="mdx-content">
            <slot />
          </article>
        </DocstubeEntity>
        <DocstubeSources sources={sources} repoUrl={repoUrl} />
        {
          footerCredit ? (
            <footer class="stp-site-footer">
              Docs by <a href="https://docstube.dev">docstube</a>
            </footer>
          ) : null
        }
      </main>
      <TableOfContents client:idle headings={headings} />
    </div>
    <DocstubeSectionChips sections={sections} />
    <script>
      // Progressive enhancement wired once per session; `astro:page-load` fires on the initial
      // load and after every view transition, so decorations re-apply to swapped-in content.
      const COPY_ICON =
        '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
      const CHECK_ICON =
        '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>';

      const addCopyButton = (shell: HTMLElement) => {
        if (shell.querySelector('.stp-copy-button')) return;
        const pre = shell.querySelector('pre');
        if (!pre) return;
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'stp-copy-button';
        button.setAttribute('aria-label', 'Copy code');
        button.innerHTML = COPY_ICON;
        button.addEventListener('click', async () => {
          const text = pre.innerText.replace(/\n$/, '');
          try {
            await navigator.clipboard.writeText(text);
          } catch {
            const textarea = document.createElement('textarea');
            textarea.value = text;
            document.body.append(textarea);
            textarea.select();
            document.execCommand('copy');
            textarea.remove();
          }
          button.classList.add('is-copied');
          button.innerHTML = CHECK_ICON;
          setTimeout(() => {
            button.classList.remove('is-copied');
            button.innerHTML = COPY_ICON;
          }, 1000);
        });
        shell.append(button);
      };

      // Fenced code: wrap each shiki pre in the source's raised shell and add the copy button.
      const decorateCodeBlocks = () => {
        for (const pre of document.querySelectorAll<HTMLElement>('pre.astro-code:not([data-stp-decorated])')) {
          pre.dataset.stpDecorated = 'true';
          const shell = document.createElement('div');
          shell.className = 'stp-code-shell';
          if (pre.querySelectorAll('.line').length <= 2) shell.classList.add('is-compact');
          pre.replaceWith(shell);
          shell.append(pre);
        }
        for (const shell of document.querySelectorAll<HTMLElement>('.stp-code-shell')) {
          addCopyButton(shell);
        }
      };

      // Code groups: build the sliding-pill tab strip (spec §5.8) from the child block titles.
      const hydrateCodeGroups = () => {
        for (const group of document.querySelectorAll<HTMLElement>(
          '[data-component="CodeGroup"]:not([data-hydrated])'
        )) {
          const panels = [...group.querySelectorAll<HTMLElement>(':scope > .stp-code-group-panels > .stp-code-figure')];
          if (panels.length === 0) continue;
          group.setAttribute('data-hydrated', 'true');
          if (panels.length < 2) continue;
          const labels = panels.map((panel, index) => {
            const caption = panel.querySelector('figcaption');
            const language = panel.querySelector('code[data-language]')?.getAttribute('data-language');
            return caption?.textContent?.trim() || language || `Tab ${index + 1}`;
          });
          const strip = document.createElement('div');
          strip.className = 'stp-tab-container is-hydrated';
          const indicator = document.createElement('div');
          indicator.className = 'stp-tab-indicator';
          strip.append(indicator);
          const buttons = labels.map((label, index) => {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'stp-tab-button';
            button.textContent = label;
            button.addEventListener('click', () => activate(index));
            strip.append(button);
            return button;
          });
          const activate = (index: number) => {
            panels.forEach((panel, panelIndex) => {
              panel.style.display = panelIndex === index ? 'block' : 'none';
              panel.classList.toggle('stp-code-fade', panelIndex === index);
            });
            buttons.forEach((button, buttonIndex) => {
              button.classList.toggle('is-active', buttonIndex === index);
            });
            const active = buttons[index];
            if (active) {
              indicator.style.left = `${active.offsetLeft}px`;
              indicator.style.width = `${active.offsetWidth}px`;
            }
          };
          group.prepend(strip);
          activate(0);
        }
      };

      // Native tables: wrap each in a horizontal scroller so wide API/config tables scroll
      // rather than clip inside the 905px content box (registry tables ship their own wrapper).
      const wrapTables = () => {
        for (const table of document.querySelectorAll<HTMLElement>('.mdx-content table:not([data-stp-scrollable])')) {
          table.dataset.stpScrollable = 'true';
          if (table.closest('.stp-comparison-wrapper') || table.closest('.stp-table-scroll')) continue;
          const wrapper = document.createElement('div');
          wrapper.className = 'stp-table-scroll';
          table.replaceWith(wrapper);
          wrapper.append(table);
        }
      };

      // Content tabs (the registry Tabs component renders the strip only).
      const wireContentTabs = () => {
        for (const tabList of document.querySelectorAll<HTMLElement>(
          '[data-component="Tabs"] [role="tablist"]:not([data-wired])'
        )) {
          tabList.dataset.wired = 'true';
          const buttons = [...tabList.querySelectorAll<HTMLElement>('[role="tab"]')];
          for (const button of buttons) {
            button.addEventListener('click', () => {
              for (const other of buttons) other.setAttribute('aria-selected', String(other === button));
            });
          }
        }
      };

      const enhance = () => {
        decorateCodeBlocks();
        hydrateCodeGroups();
        wrapTables();
        wireContentTabs();
      };
      document.addEventListener('astro:page-load', enhance);
      enhance();

      // Mobile drawer: the hamburger toggles the attribute the CSS keys on; navigation and
      // Escape close it, and closing returns focus to the hamburger so keyboard users are not
      // stranded in the removed drawer content.
      const closeMobileNav = () => {
        if (!document.documentElement.hasAttribute('data-mobile-nav-open')) return;
        document.documentElement.removeAttribute('data-mobile-nav-open');
        document.querySelector<HTMLElement>('[data-stp-hamburger]')?.focus();
      };
      document.addEventListener('click', (event) => {
        const target = event.target as HTMLElement | null;
        if (target?.closest('[data-stp-hamburger]')) {
          document.documentElement.toggleAttribute('data-mobile-nav-open');
        }
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeMobileNav();
      });
      document.addEventListener('astro:after-swap', closeMobileNav);
    </script>
  </body>
</html>
