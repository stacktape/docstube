---
// docstube Callout renderer: tinted panel, colored border, outlined icon (theme spec §2.7).
const { tone = 'info', title } = Astro.props;
const icons = {
  info: '<circle cx="12" cy="12" r="9" /><path d="M12 8h.01M11 12h1v4h1" stroke-linecap="round" />',
  note: '<path d="M12 20h9" stroke-linecap="round" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" stroke-linejoin="round" />',
  success: '<circle cx="12" cy="12" r="9" /><path d="m8 12.4 2.7 2.6L16 9.5" stroke-linecap="round" stroke-linejoin="round" />',
  warning:
    '<path d="M10.3 3.9 1.9 18a2 2 0 0 0 1.7 3h16.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" stroke-linejoin="round" /><path d="M12 9v4M12 17h.01" stroke-linecap="round" />',
  danger: '<circle cx="12" cy="12" r="9" /><path d="M15 9l-6 6M9 9l6 6" stroke-linecap="round" />'
};
const icon = icons[tone] ?? icons.info;
---

<aside class={`dt-callout dt-callout--${tone}`} data-component="Callout">
  <span class="dt-callout-icon" aria-hidden="true">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" set:html={icon} />
  </span>
  <div class="dt-callout-body">
    {title ? <p class="dt-callout-title">{title}</p> : null}
    <div class="dt-callout-content"><slot /></div>
  </div>
</aside>
