---
// Generated by docstube (kernel-owned) — the guarantee badge every theme mounts.
const { guarantee, title, class: className } = Astro.props;
const guaranteeLabels = {"proven":"verified","scored":"reviewed","out-of-domain":"unverified"};
const classes = ["dt-guarantee", `dt-guarantee--${guarantee}`, className].filter(Boolean).join(" ");
---

<span class={classes} data-docstube-guarantee={guarantee} title={title}>
  {guaranteeLabels[guarantee] ?? guarantee}
</span>
